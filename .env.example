# Google Gemini API
# Получите бесплатный ключ на https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Настройки сервера
HOST=127.0.0.1
PORT=8000

# Опционально: Прокси-сервер (если доступ к Gemini API заблокирован по геопозиции)
# HTTP_PROXY=http://username:password@host:port
# HTTPS_PROXY=http://username:password@host:port
